# ===========================================
# Flowly 环境配置示例
# 复制此文件为 .env 并修改相应配置
# ===========================================
#
# 安全警告:
# 1. 切勿将真实密钥直接写入此文件
# 2. .env 文件必须加入 .gitignore
# 3. 生产环境必须设置所有必填项
# 4. 使用 python -c "import secrets; print(secrets.token_urlsafe(50))" 生成强密钥
#

# ========== 应用配置 ==========
APP_NAME=Flowly
APP_ENV=development

# DEBUG: 开发环境可设为 true，生产环境必须为 false
DEBUG=true

# ========== 安全配置 (必填) ==========
# ⚠️ 必填: 使用 secrets.token_urlsafe(50) 生成
# ⚠️ 生产环境禁止使用默认值
DJANGO_SECRET_KEY=your-super-secret-key-generate-with-secrets-module

# ========== 主数据库配置 (MySQL - Docker) ==========
# ⚠️ 必填: 生产环境使用强密码 (最少16字符)
DB_NAME=flowly_db
DB_USER=root
# ⚠️ 必填
DB_PASSWORD=<your-strong-database-password-min-16-chars>
DB_HOST=localhost
DB_PORT=3307

# ========== 向量数据库配置 (PostgreSQL + pgvector) ==========
# ⚠️ 必填: 生产环境使用强密码
PG_NAME=flowly_vector
PG_USER=flowly
# ⚠️ 必填
PG_PASSWORD=<your-strong-pg-password>
PG_HOST=localhost
PG_PORT=5432

# ========== 后端服务配置 ==========
# ⚠️ 生产环境必填: 逗号分隔的域名列表
# 示例: your-domain.com,app.your-domain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ⚠️ 生产环境必填: 逗号分隔的允许跨域来源
# 示例: https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ========== Redis 配置 ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_URL=redis://localhost:6379/1

# ========== Celery 配置 ==========
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ========== 前端 API 配置 ==========
VITE_API_URL=http://localhost:8000
VITE_API_PREFIX=/api/v1
VITE_WS_URL=ws://localhost:8000
# 前端请求超时和重试配置 (可选)
VITE_API_TIMEOUT_MS=30000
VITE_API_MAX_RETRIES=1

# ========== AI 模型配置 ==========
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# ========== Z-Image-Turbo 本地部署配置 ==========
# 默认使用 Tongyi-MAI/Z-Image-Turbo，RTX 4060 8GB 建议开启 CPU offload
ZIMAGE_MODEL_ID=Tongyi-MAI/Z-Image-Turbo
ZIMAGE_DEVICE=cuda
ZIMAGE_DTYPE=auto
ZIMAGE_ENABLE_CPU_OFFLOAD=true
ZIMAGE_NUM_INFERENCE_STEPS=9
ZIMAGE_GUIDANCE_SCALE=0.0
ZIMAGE_DEFAULT_WIDTH=1024
ZIMAGE_DEFAULT_HEIGHT=1024

# ========== LangSmith 追踪配置 (可选) ==========
# ⚠️ 不要在示例文件中填写真实 API Key
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=flowly-default
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ========== Docker 沙箱配置 ==========
DOCKER_ENABLED=auto
DOCKER_CODE_IMAGE=python:3.12-slim
DOCKER_MEMORY_LIMIT=256
DOCKER_CPU_LIMIT=0.5
DOCKER_TIMEOUT=60
DOCKER_POOL_SIZE=3

# ========== 日志配置 ==========
DJANGO_LOG_LEVEL=INFO

# ========== 生产环境额外配置 ==========
# 生产环境请取消注释并设置:
# DEBUG=false
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# ALLOWED_HOSTS=your-domain.com,app.your-domain.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
