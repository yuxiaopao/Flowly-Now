# Environment Configuration for E2E Tests
# Copy this file to .env and adjust values as needed

# Django Backend URL
DJANGO_BASE_URL=http://localhost:8000

# Frontend URL (for Playwright tests)
VITE_API_BASE=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Set to "true" if Ollama is running and accessible
# Tests requiring Ollama will be skipped if this is "false"
OLLAMA_AVAILABLE=false

# Test Authentication (optional)
# Create a test user and set token here, or tests will try to authenticate
TEST_USERNAME=testuser
TEST_PASSWORD=testpass123
TEST_AUTH_TOKEN=

# Playwright Configuration
PLAYWRIGHT_BROWSERS_PATH=./playwright-browsers
PLAYWRIGHT_SLOW_MO=100

# Test Timeouts (in seconds)
TEST_TIMEOUT=120
STREAM_TIMEOUT=60
OLLAMA_TIMEOUT=30
