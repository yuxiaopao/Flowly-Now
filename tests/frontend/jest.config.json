{
  "testEnvironment": "jest-environment-jsdom",
  "testMatch": [
    "**/tests/frontend/**/*.test.{js,ts}",
    "**/tests/frontend/**/*.spec.{js,ts}"
  ],
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/dist/"
  ],
  "transform": {
    "^.+\\.js$": "babel-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../../Frontend/src/$1"
  },
  "moduleFileExtensions": [
    "js",
    "json",
    "vue"
  ],
  "collectCoverageFrom": [
    "../../Frontend/src/api/**/*.{js}",
    "!../../Frontend/src/main.js"
  ],
  "coverageDirectory": "../artifacts/frontend/jest-coverage",
  "reporters": [
    "default",
    [
      "jest-junit",
      {
        "outputDirectory": "../artifacts/frontend",
        "outputName": "jest-junit.xml"
      }
    ]
  ],
  "rootDir": ".",
  "maxWorkers": 1
}
