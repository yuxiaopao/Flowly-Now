# Flowly Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# ===================
# API Configuration
# ===================

# Backend API URL (default: http://localhost:8000 for development)
VITE_API_URL=http://localhost:8000

# API Prefix (default: /api/v1)
VITE_API_PREFIX=/api/v1

# WebSocket URL (optional, defaults to current host)
# WebSocket base URL (full ws:// or wss:// URL recommended for dev)
VITE_WS_URL=ws://127.0.0.1:8000

# ===================
# LLM / Embedding Defaults
# ===================
# Initial defaults before /public/site-config/ loads; runtime config overrides these.

VITE_LLM_DEFAULT_MODEL=qwen2.5-coder:7b
VITE_DEFAULT_EMBEDDING_MODEL=nomic-embed-text
VITE_LLM_DEFAULT_TEMPERATURE=0.7
VITE_LLM_DEFAULT_MAX_TOKENS=2000

# NL workflow generation timeout (ms)
VITE_NL_WORKFLOW_TIMEOUT_MS=600000

# ===================
# Vector Store Defaults
# ===================
VITE_VECTOR_STORE_DEFAULT_HOST=localhost

# Default vector store port
VITE_VECTOR_STORE_DEFAULT_PORT=6333

# Default protocol (http or https)
# VITE_VECTOR_STORE_DEFAULT_PROTOCOL=http

# ===================
# Domain Configuration
# ===================

# Main application domain
VITE_MAIN_DOMAIN=flowly.com

# API subdomain
VITE_API_SUBDOMAIN=api.flowly.com

# Tenant subdomain pattern
VITE_TENANT_SUBDOMAIN=flowly.com

# ===================
# Documentation Links
# ===================

VITE_DOCS_URL=https://docs.flowly.com
VITE_API_DOCS_URL=https://docs.flowly.com/api
VITE_SUPPORT_URL=https://flowly.com/support

# ===================
# Social Login
# ===================

# Google OAuth Client ID
# VITE_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_REDIRECT_URI=

# ===================
# Router Configuration
# ===================

# Use hash router instead of history mode
# Set to 'true' if not using server-side routing
# VITE_USE_HASH_ROUTER=false
