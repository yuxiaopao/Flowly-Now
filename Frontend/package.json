{
  "name": "flowly-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build:avatar && node scripts/copy-spline-wasm.mjs",
    "prebuild": "npm run build:avatar && node scripts/copy-spline-wasm.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:electron": "vite build --mode electron",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "test": "vitest",
    "test:unit": "vitest run && npm run test:avatar",
    "test:run": "vitest run && npm run test:avatar",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "build:avatar": "vue-tsc --noEmit -p avatar-studio/tsconfig.json && vite build --config avatar-studio/vite.config.mjs",
    "test:avatar": "vitest run --config avatar-studio/vitest.config.mjs",
    "prebuild:electron": "npm run build:avatar && node scripts/copy-spline-wasm.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@splinetool/modelling-wasm": "1.12.68",
    "@splinetool/runtime": "1.12.68",
    "@splinetool/ui-wasm": "1.12.68",
    "@types/dagre": "^0.7.54",
    "@vue-flow/background": "^1.3.0",
    "@vue-flow/controls": "^1.1.0",
    "@vue-flow/core": "^1.33.5",
    "@vue-flow/minimap": "^1.4.0",
    "3d-force-graph": "^1.73.0",
    "axios": "^1.6.8",
    "chart.js": "^4.5.1",
    "d3": "^7.9.0",
    "dagre": "^0.8.5",
    "dayjs": "^1.11.10",
    "dompurify": "^3.4.11",
    "echarts": "^5.5.0",
    "echarts-for-vue": "^1.4.1",
    "element-plus": "^2.5.6",
    "html-to-image": "^1.11.13",
    "js-cookie": "^3.0.5",
    "lucide-vue-next": "^0.344.0",
    "marked": "^18.0.5",
    "mediabunny": "1.54.0",
    "pinia": "^2.1.7",
    "three": "^0.169.0",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.0.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^1.3.1",
    "@vue/test-utils": "^2.4.4",
    "eslint": "^8.57.0",
    "eslint-plugin-unused-imports": "^3.2.0",
    "eslint-plugin-vue": "^9.22.0",
    "happy-dom": "20.11.2",
    "jsdom": "^24.0.0",
    "sass": "^1.72.0",
    "sass-embedded": "^1.99.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.1.6",
    "vitest": "^1.3.1",
    "vue-tsc": "3.3.9"
  }
}
