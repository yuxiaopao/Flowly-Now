{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flowly.ai/api/v1/schemas",
  "title": "Flowly API JSON Schemas",
  "version": "1.0.0",
  "definitions": {
    "PaginatedResponse": {
      "type": "object",
      "properties": {
        "count": { "type": "integer" },
        "next": { "type": ["string", "null"] },
        "previous": { "type": ["string", "null"] },
        "results": { "type": "array", "items": {} }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": { "type": "string" },
        "detail": { "type": "string" },
        "code": { "type": "string" }
      }
    },
    "UserSimple": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "avatar": { "type": ["string", "null"] }
      }
    },
    "User": {
      "allOf": [
        { "$ref": "#/definitions/UserSimple" },
        {
          "type": "object",
          "properties": {
            "first_name": { "type": "string" },
            "last_name": { "type": "string" },
            "role": { "type": "string", "enum": ["admin", "developer", "user"] },
            "phone": { "type": "string" },
            "bio": { "type": "string" },
            "default_model": { "type": "string" },
            "total_executions": { "type": "integer" },
            "monthly_executions": { "type": "integer" },
            "execution_limit": { "type": "integer" },
            "created_at": { "type": "string", "format": "date-time" },
            "last_login_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "WorkflowList": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "owner": { "$ref": "#/definitions/UserSimple" },
        "status": { "type": "string", "enum": ["draft", "active", "paused", "archived"] },
        "status_display": { "type": "string" },
        "is_published": { "type": "boolean" },
        "is_public": { "type": "boolean" },
        "version": { "type": "integer" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "node_count": { "type": "integer" },
        "execution_count": { "type": "integer" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "WorkflowDetail": {
      "allOf": [
        { "$ref": "#/definitions/WorkflowList" },
        {
          "type": "object",
          "properties": {
            "settings": { "type": "object" },
            "parent": { "type": ["integer", "null"] },
            "nodes": { "type": "array", "items": { "$ref": "#/definitions/Node" } },
            "edges": { "type": "array", "items": { "$ref": "#/definitions/Edge" } }
          }
        }
      ]
    },
    "WorkflowCreate": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "active", "paused"] },
        "is_published": { "type": "boolean" },
        "is_public": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "settings": { "type": "object" },
        "nodes": { "type": "array", "items": { "$ref": "#/definitions/NodeCreate" } },
        "edges": { "type": "array", "items": { "$ref": "#/definitions/EdgeCreate" } }
      }
    },
    "WorkflowUpdate": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "active", "paused", "archived"] },
        "is_published": { "type": "boolean" },
        "is_public": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "settings": { "type": "object" }
      }
    },
    "Node": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "workflow": { "type": "integer" },
        "node_type": { "type": "string" },
        "node_type_display": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "position_x": { "type": "integer" },
        "position_y": { "type": "integer" },
        "config": { "type": "object" },
        "style": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "NodeCreate": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "node_type": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "position_x": { "type": "integer" },
        "position_y": { "type": "integer" },
        "config": { "type": "object" },
        "style": { "type": "object" }
      }
    },
    "Edge": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "workflow": { "type": "integer" },
        "source_node": { "type": "integer" },
        "source_node_name": { "type": "string" },
        "target_node": { "type": "integer" },
        "target_node_name": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string" },
        "animated": { "type": "boolean" },
        "condition": { "type": "object" }
      }
    },
    "EdgeCreate": {
      "type": "object",
      "required": ["source", "target"],
      "properties": {
        "source": { "type": "string" },
        "target": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string" },
        "animated": { "type": "boolean" },
        "condition": { "type": "object" }
      }
    },
    "Execution": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "workflow": { "type": "integer" },
        "workflow_name": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "running", "completed", "failed", "cancelled"] },
        "status_display": { "type": "string" },
        "trigger_type": { "type": "string" },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "duration": { "type": ["number", "null"] }
      }
    },
    "ExecutionDetail": {
      "allOf": [
        { "$ref": "#/definitions/Execution" },
        {
          "type": "object",
          "properties": {
            "input_data": { "type": "object" },
            "output_data": { "type": "object" },
            "error_message": { "type": ["string", "null"] },
            "node_status": { "type": "object" }
          }
        }
      ]
    },
    "AgentList": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "agent_type": { "type": "string", "enum": ["conversational", "task", "research", "coding"] },
        "model": { "type": "string" },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "AgentDetail": {
      "allOf": [
        { "$ref": "#/definitions/AgentList" },
        {
          "type": "object",
          "properties": {
            "system_prompt": { "type": "string" },
            "temperature": { "type": "number" },
            "max_tokens": { "type": "integer" },
            "tools": { "type": "array", "items": { "type": "string" } },
            "skills": { "type": "array", "items": { "type": "string" } },
            "memory_enabled": { "type": "boolean" },
            "context_window": { "type": "integer" },
            "settings": { "type": "object" },
            "tools_detail": { "type": "array", "items": { "$ref": "#/definitions/AgentTool" } }
          }
        }
      ]
    },
    "AgentCreate": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string" },
        "agent_type": { "type": "string", "enum": ["conversational", "task", "research", "coding"] },
        "system_prompt": { "type": "string" },
        "model": { "type": "string" },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "max_tokens": { "type": "integer" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "skills": { "type": "array", "items": { "type": "string" } },
        "memory_enabled": { "type": "boolean" },
        "context_window": { "type": "integer" },
        "is_active": { "type": "boolean" }
      }
    },
    "AgentUpdate": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "agent_type": { "type": "string", "enum": ["conversational", "task", "research", "coding"] },
        "system_prompt": { "type": "string" },
        "model": { "type": "string" },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "max_tokens": { "type": "integer" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "skills": { "type": "array", "items": { "type": "string" } },
        "memory_enabled": { "type": "boolean" },
        "context_window": { "type": "integer" },
        "is_active": { "type": "boolean" }
      }
    },
    "AgentTool": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "tool_type": { "type": "string" },
        "config": { "type": "object" },
        "is_enabled": { "type": "boolean" }
      }
    },
    "AgentChatRequest": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string" },
        "conversation_id": { "type": ["integer", "null"] }
      }
    },
    "AgentChatResponse": {
      "type": "object",
      "properties": {
        "conversation_id": { "type": "integer" },
        "response": { "type": "string" },
        "tool_calls": { "type": "array" }
      }
    },
    "ChatMessage": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "role": { "type": "string", "enum": ["user", "assistant", "system"] },
        "content": { "type": "string" }
      }
    },
    "AgentConversation": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "agent": { "type": "integer" },
        "messages": { "type": "array", "items": { "$ref": "#/definitions/ChatMessage" } },
        "summary": { "type": "string" },
        "message_count": { "type": "integer" },
        "token_count": { "type": "integer" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "AgentExecution": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "agent": { "type": "integer" },
        "agent_name": { "type": "string" },
        "conversation": { "type": ["integer", "null"] },
        "status": { "type": "string", "enum": ["pending", "running", "completed", "failed"] },
        "input_data": { "type": "object" },
        "output_data": { "type": "object" },
        "error_message": { "type": ["string", "null"] },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "PromptCategory": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "prompt_count": { "type": "integer" }
      }
    },
    "PromptDetail": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "prompt_type": { "type": "string", "enum": ["system", "user", "assistant", "task"] },
        "template": { "type": "string" },
        "variables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "required": { "type": "boolean" }
            }
          }
        },
        "category": { "$ref": "#/definitions/PromptCategory" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "use_count": { "type": "integer" },
        "avg_rating": { "type": "number" },
        "rating_count": { "type": "integer" },
        "is_featured": { "type": "boolean" },
        "creator_name": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "PromptCreate": {
      "type": "object",
      "required": ["name", "template"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "prompt_type": { "type": "string", "enum": ["system", "user", "assistant", "task"] },
        "template": { "type": "string" },
        "variables": { "type": "array" },
        "category_id": { "type": "integer" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "temperature": { "type": "number" },
        "max_tokens": { "type": "integer" }
      }
    },
    "NLSession": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "workflow_id": { "type": ["integer", "null"] },
        "status": { "type": "string", "enum": ["active", "completed", "failed"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "NLSessionCreateRequest": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "NLPreviewRequest": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": { "type": "string" }
      }
    },
    "NLPreviewResponse": {
      "type": "object",
      "properties": {
        "preview": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "description": { "type": "string" },
            "nodes": { "type": "array" },
            "edges": { "type": "array" },
            "node_count": { "type": "integer" },
            "edge_count": { "type": "integer" }
          }
        },
        "message": { "type": "string" }
      }
    },
    "AlertRule": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "condition": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "threshold": { "type": "number" },
        "time_window_minutes": { "type": "integer" },
        "notify_email": { "type": "boolean" },
        "notify_webhook": { "type": "boolean" },
        "webhook_url": { "type": "string" },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "AlertRuleCreate": {
      "type": "object",
      "required": ["name", "condition", "severity", "threshold"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "condition": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "threshold": { "type": "number" },
        "time_window_minutes": { "type": "integer" },
        "notify_email": { "type": "boolean" },
        "notify_webhook": { "type": "boolean" },
        "webhook_url": { "type": "string" },
        "is_active": { "type": "boolean" }
      }
    },
    "DashboardMetrics": {
      "type": "object",
      "properties": {
        "total_executions": { "type": "integer" },
        "executions_this_month": { "type": "integer" },
        "successful_executions": { "type": "integer" },
        "success_rate": { "type": "number" },
        "active_alerts": { "type": "integer" },
        "workflow_count": { "type": "integer" }
      }
    },
    "PricePlan": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "plan_type": { "type": "string", "enum": ["free", "starter", "professional", "enterprise"] },
        "plan_type_display": { "type": "string" },
        "billing_cycle": { "type": "string", "enum": ["monthly", "yearly"] },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "max_workflows": { "type": "integer" },
        "max_executions_per_month": { "type": "integer" },
        "max_team_members": { "type": "integer" },
        "max_storage_gb": { "type": "integer" },
        "max_api_calls_per_month": { "type": "integer" },
        "enable_advanced_nodes": { "type": "boolean" },
        "enable_version_history": { "type": "boolean" },
        "enable_custom_domain": { "type": "boolean" }
      }
    },
    "Subscription": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "plan_type": { "type": "string", "enum": ["free", "starter", "professional", "enterprise"] },
        "plan_type_display": { "type": "string" },
        "billing_cycle": { "type": "string", "enum": ["monthly", "yearly"] },
        "status": { "type": "string" },
        "status_display": { "type": "string" },
        "is_trial": { "type": "boolean" },
        "trial_ends_at": { "type": ["string", "null"], "format": "date-time" },
        "current_period_start": { "type": "string", "format": "date-time" },
        "current_period_end": { "type": "string", "format": "date-time" },
        "cancel_at_period_end": { "type": "boolean" }
      }
    },
    "SubscriptionCreate": {
      "type": "object",
      "required": ["plan_type"],
      "properties": {
        "plan_type": { "type": "string", "enum": ["free", "starter", "professional", "enterprise"] },
        "billing_cycle": { "type": "string", "enum": ["monthly", "yearly"] }
      }
    },
    "UsageRecord": {
      "type": "object",
      "properties": {
        "period_start": { "type": "string", "format": "date-time" },
        "period_end": { "type": "string", "format": "date-time" },
        "workflow_count": { "type": "integer" },
        "execution_count": { "type": "integer" },
        "api_call_count": { "type": "integer" },
        "storage_used_mb": { "type": "number" },
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "total_cost": { "type": "number" }
      }
    },
    "Webhook": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "events": { "type": "array", "items": { "type": "string" } },
        "headers": { "type": "object" },
        "is_active": { "type": "boolean" },
        "is_verified": { "type": "boolean" },
        "retry_count": { "type": "integer" },
        "timeout_seconds": { "type": "integer" },
        "total_deliveries": { "type": "integer" },
        "successful_deliveries": { "type": "integer" },
        "failed_deliveries": { "type": "integer" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "WebhookCreate": {
      "type": "object",
      "required": ["name", "url", "events"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "events": { "type": "array", "items": { "type": "string" } },
        "secret": { "type": "string" },
        "headers": { "type": "object" },
        "retry_count": { "type": "integer" },
        "timeout_seconds": { "type": "integer" }
      }
    },
    "TemplateDetail": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "category": {
          "type": "object",
          "properties": {
            "id": { "type": "integer" },
            "name": { "type": "string" },
            "slug": { "type": "string" }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "nodes": { "type": "array" },
        "edges": { "type": "array" },
        "install_count": { "type": "integer" },
        "view_count": { "type": "integer" },
        "avg_rating": { "type": "number" },
        "rating_count": { "type": "integer" },
        "is_verified": { "type": "boolean" },
        "is_featured": { "type": "boolean" },
        "author_name": { "type": "string" },
        "author_avatar": { "type": "string" },
        "is_installed": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "TenantDetail": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended", "trial", "cancelled"] },
        "plan": { "type": "string", "enum": ["free", "starter", "professional", "enterprise"] },
        "owner": { "$ref": "#/definitions/UserSimple" },
        "settings": { "type": "object" },
        "custom_domain": { "type": "string" },
        "max_users": { "type": "integer" },
        "max_workflows": { "type": "integer" },
        "max_executions_per_month": { "type": "integer" },
        "billing_email": { "type": "string", "format": "email" },
        "subscription_id": { "type": "string" },
        "subscription_end": { "type": ["string", "null"], "format": "date-time" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "TenantMembership": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "user": { "$ref": "#/definitions/UserSimple" },
