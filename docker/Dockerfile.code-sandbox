# Flowly code execution sandbox — numpy/scipy/pandas/matplotlib for CUMCM nodes
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir \
        numpy>=1.24,<3.0 \
        scipy>=1.10,<2.0 \
        pandas>=2.0,<3.0 \
        matplotlib>=3.7,<4.0

WORKDIR /code
