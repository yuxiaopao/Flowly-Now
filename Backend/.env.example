# ===========================================
# Flowly Backend 环境配置示例
# 复制此文件为 .env 并修改相应配置
# ===========================================

# ========== 安全配置 ==========
# 重要: 生产环境请使用随机生成的密钥
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# ========== 数据库配置 ==========
DB_NAME=flowly
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# ========== 跨域与 URL ==========
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5200,http://127.0.0.1:5200,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5200
# 前端 Webhook/SSE 使用的后端 API 根地址（必须与前端 VITE_API_URL 一致）
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# 可选：WebSocket 根地址（留空则从 PUBLIC_API_BASE_URL 推导 ws/wss）
PUBLIC_WS_URL=

# ========== Redis 配置 ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_URL=redis://localhost:6379/1

# ========== Celery 配置 ==========
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ========== AI 模型配置 ==========
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=qwen2.5-coder:7b
DEFAULT_EMBEDDING_MODEL=text-embedding-ada-002
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4096

# ========== 本地 Ollama ==========
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192

# NL 工作流（推荐 Agnes 云端，避免依赖本地 Ollama）
NL_WORKFLOW_MODEL=agnes-2.0-flash
NL_WORKFLOW_TEMPERATURE=0.7
NL_CHAT_MAX_TOKENS=512
NL_GENERATE_MAX_TOKENS=4096
NL_WORKFLOW_USE_TEMPLATES=false
NL_WORKFLOW_TEMPLATE_FALLBACK=true

# ========== 阿里云百炼 DashScope 配置 ==========
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ========== 视频翻译 / 媒体公网访问 ==========
# DashScope Paraformer / VideoRetalk 需要公网可访问的媒体 URL
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:8000
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
VIDEO_TRANSLATION_MAX_DURATION_SEC=300
VIDEO_TRANSLATION_MAX_FILE_MB=200

# ========== Agnes AI 多模态 API Hub ==========
# OpenAI 兼容网关：LLM(agnes-2.0-flash)、文生图(agnes-image-2.1-flash)、文生视频(agnes-video-v2.0)
AGNES_API_KEY=your-agnes-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# ========== Qdrant 向量库（可选） ==========
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ========== 邮件 SMTP（可选，未配置则 console 后端） ==========
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@flowly.local
EMAIL_TIMEOUT=10

# ========== LangSmith 追踪配置 ==========
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=flowly-default
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ========== Docker 沙箱配置 ==========
DOCKER_ENABLED=auto
DOCKER_CODE_IMAGE=python:3.12-slim
DOCKER_MEMORY_LIMIT=256
DOCKER_CPU_LIMIT=0.5
DOCKER_TIMEOUT=60
DOCKER_POOL_SIZE=3

# ========== 日志配置 ==========
DJANGO_LOG_LEVEL=INFO

# ========== 生产环境配置 (取消注释并修改) ==========
# DEBUG=False
# ALLOWED_HOSTS=your-domain.com
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# FRONTEND_URL=https://your-domain.com
# PUBLIC_API_BASE_URL=https://api.your-domain.com
